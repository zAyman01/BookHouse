# =============================================================================
# Book House — Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# The server and client both read from this single root .env file.
# =============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/book-house
# Atlas: mongodb+srv://<user>:<password>@cluster.xxxxx.mongodb.net/bookhouse
MONGODB_URI=mongodb://localhost:27017/book-house

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a secure random key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters required.
JWT_SECRET=change_this_to_a_random_64_character_hex_string
JWT_EXPIRE=30d

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Leave empty to use Ethereal test emails (dev only — emails viewable in console)
# For production, configure a real SMTP provider:
#   SendGrid: smtp.sendgrid.net:587
#   Mailgun:   smtp.mailgun.org:587
#   Gmail:     smtp.gmail.com:587 (requires App Password)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Used for avatar and book cover image uploads.
# Get free credentials from https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Client ───────────────────────────────────────────────────────────────────
# URL where the React app runs (for CORS on the server)
CLIENT_URL=http://localhost:5173

# In production, set this to your deployed client URL
# PRODUCTION_URL=https://your-app.com

# API base URL used by the client (must include /api suffix)
VITE_API_URL=/api
